{
  "name": "trao-backend",
  "private": true,
  "version": "1.0.0",
  "description": "Backend for the Trao project",
  "license": "ISC",
  "author": "Aman Singh",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
